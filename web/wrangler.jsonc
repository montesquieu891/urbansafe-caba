// Publicación de UrbanSafe CABA como Worker de recursos estáticos (sin código de servidor).
// Solo se sube dist/, auditado por `npm run audit:dist`; _headers aplica CSP y caché.
// `--env preview` publica la misma compilación en un Worker aparte para revisarla antes de producción.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urbansafe-caba",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false,
  "env": {
    "preview": {
      "name": "urbansafe-caba-preview",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash"
      },
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
